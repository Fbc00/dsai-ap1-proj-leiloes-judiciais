{
  "name": "leiloes-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build:frontend": "pnpm --dir ../frontend build",
    "dev": "wrangler dev",
    "deploy": "pnpm build:frontend && wrangler deploy",
    "check": "pnpm build:frontend && wrangler deploy --dry-run",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
